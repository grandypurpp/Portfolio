{
  "name": "signature-edit-style-template",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion template for the signature edit style: kinetic punch text, title cards, screen cards, swipe transitions, beat-aware cuts.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SignatureEdit out/edit.mp4",
    "render:vertical": "remotion render SignatureEditVertical out/edit-vertical.mp4",
    "still": "remotion still SignatureEdit out/still.png",
    "final": "python3 finalize.py timeline.json",
    "final:vertical": "python3 finalize.py timeline.json --vertical"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
